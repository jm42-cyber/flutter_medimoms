# Production Environment Configuration
# Used when building release: flutter build apk --release

# API Configuration
API_URL=https://api.medimoms.com/api
API_TIMEOUT=30000

# App Configuration
APP_NAME=MediMoms
APP_VERSION=1.0.0
APP_ENV=production

# Feature Flags
ENABLE_DEBUG_LOGS=false
ENABLE_BIOMETRIC=true
ENABLE_OFFLINE_MODE=false
